{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-in",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "projectforge-db",
      "database_id": "06d1da39-d147-4549-8c18-bfe699af8f51"
    }
  ]
}
